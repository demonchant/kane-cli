# Optional: these default to the bundled, isolated demo target.
PATCHLOOP_HOST=127.0.0.1
PATCHLOOP_PORT=4173
# Kane accepts 60–1800 seconds; the default allows longer multi-flow browser plans.
PATCHLOOP_KANE_TIMEOUT_SECONDS=900
# PATCHLOOP_TARGET_REPO=C:\absolute\path\to\a\git\repository

# The agent and Kane must already be installed and authenticated in their own CLIs.
# PATCHLOOP_CODEX_ENTRY=C:\Users\you\AppData\Roaming\npm\node_modules\@openai\codex\bin\codex.js
# PATCHLOOP_KANE_ENTRY=C:\Users\you\AppData\Roaming\npm\node_modules\@testmuai\kane-cli\bin\kane-cli.cjs

# Optional hosted login mode. Set these as Render secrets/configuration, never in browser code.
# Google OAuth authorized redirect URI: https://<your-service>.onrender.com/auth/google/callback
# PATCHLOOP_AUTH_MODE=google
# PATCHLOOP_PUBLIC_URL=https://<your-service>.onrender.com
# PATCHLOOP_SESSION_SECRET=<at least 32 random bytes>
# GOOGLE_CLIENT_ID=<Google OAuth web client ID>
# GOOGLE_CLIENT_SECRET=<Google OAuth web client secret>
# PATCHLOOP_EXECUTION_MODE=disabled
